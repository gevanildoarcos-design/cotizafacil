# ============================================================
# CotizaFácil · variáveis de ambiente (copie para .env.local)
# NUNCA comite chaves reais. Todo valor abaixo é um placeholder.
# ============================================================

# ---------- App ----------
NEXT_PUBLIC_APP_URL="https://coti-facil.com"
NEXT_PUBLIC_DEFAULT_LOCALE="pt"

# ---------- Supabase (auth + banco) ----------
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave_anon_publica"
# Somente servidor (rotas de API, webhooks, cron) — nunca use no cliente
SUPABASE_SERVICE_ROLE_KEY="chave_service_role_secreta"

# ---------- Gateway de pagamento ----------
# PAYMENT_PROVIDER: stripe | mercadopago (veja config/payment.config.ts)
PAYMENT_PROVIDER="mercadopago"
PAYMENT_CURRENCY="BRL"
PAYMENT_TRIAL_DAYS="0"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY="price_xxx_starter_monthly"
NEXT_PUBLIC_STRIPE_PRICE_STARTER_ANNUAL="price_xxx_starter_annual"
NEXT_PUBLIC_STRIPE_PRICE_COMPLETE_MONTHLY="price_xxx_complete_monthly"
NEXT_PUBLIC_STRIPE_PRICE_COMPLETE_ANNUAL="price_xxx_complete_annual"
NEXT_PUBLIC_STRIPE_PRICE_GROWTH_MONTHLY="price_xxx_growth_monthly"
NEXT_PUBLIC_STRIPE_PRICE_GROWTH_ANNUAL="price_xxx_growth_annual"

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxxxxxxx"
MP_WEBHOOK_SECRET="chave_secreta_do_webhook_mp"
MP_BACK_URL="https://coti-facil.com/assinatura"

# ---------- E-mail (lembrete 3 dias antes do vencimento) ----------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="CotizaFácil <lembretes@coti-facil.com>"

# ---------- Cron ----------
# Vercel injeta CRON_SECRET no header Authorization: Bearer <valor>
CRON_SECRET="defina_uma_string_aleatoria_longa"
